    "@nimiq/mini-app-sdk": "0.1.0",
    "chess.js": "1.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "zod": "4.6.2"
